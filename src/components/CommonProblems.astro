---
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const problems = [
  {
    n: '01',
    title: 'Root Intrusion',
    image: 'IMG_5922.jpg',
    badge: 'Clay → ABS',
    body: 'Tree roots squeeze into hairline cracks and joints, then grow into a full blockage. Classic on LA properties with mature trees and clay sewer lines.',
  },
  {
    n: '02',
    title: 'Offset Pipe Joints',
    image: 'IMG_5921.jpg',
    badge: 'Main line',
    body: 'Decades of soil shift cause pipe sections to separate. Water and waste leak out, soil settles, and the line slowly collapses inward.',
  },
  {
    n: '03',
    title: 'Cracked Clay Pipe',
    image: 'IMG_5930.jpg',
    badge: 'Pre-1970 homes',
    body: 'Brittle vitrified clay is still under thousands of LA homes. Hairline cracks become backups, and once it breaks, spot-patches rarely hold.',
  },
  {
    n: '04',
    title: 'Rusted Cast Iron',
    image: 'IMG_5929.jpg',
    badge: 'Crawlspace / sub-slab',
    body: 'Cast iron rots from the inside out. The bottom of the pipe flakes away and waste flows through a rust shell. Common under mid-century homes.',
  },
  {
    n: '05',
    title: 'Pipe Bellies & Standing Water',
    image: 'IMG_5928.jpg',
    badge: 'Low-slope line',
    body: 'A dip in the sewer line holds water and solids. It looks fine on camera for a while, then backs up every time a load of laundry runs.',
  },
  {
    n: '06',
    title: 'Collapsed Sewer Lines',
    image: 'IMG_5920.jpg',
    badge: 'Full replacement',
    body: 'When a section caves in, the yard stops draining and nothing clears it with a snake. Trenchless or open-trench replacement is the only real fix.',
  },
];
---

<section class="problems section section-dark" aria-labelledby="problems-title">
  <div class="problems__bg" aria-hidden="true"></div>
  <div class="container">
    <header class="problems__header">
      <span class="eyebrow">Field Report</span>
      <h2 id="problems-title" class="section-title">Common sewer problems we find every week.</h2>
      <p class="section-lead">
        Every photo below is an actual Sewer Pipe Pros job in Greater LA. If your home has slow drains, gurgles, or a sewer smell in the yard, you're probably looking at one of these.
      </p>
    </header>

    <div class="problems__carousel" data-problems-carousel>
      <div class="problems__track" data-track tabindex="0" role="group" aria-label="Common sewer problems, scrollable">
        {problems.map((p) => (
          <article class="problems__card reveal" data-card>
            <figure class="problems__figure">
              <img
                src={`${base}/jobs/${p.image}`}
                alt={`${p.title}, real Sewer Pipe Pros job in Los Angeles`}
                width="1200"
                height="1600"
                loading="lazy"
                decoding="async"
              />
              <span class="problems__n" aria-hidden="true">{p.n}</span>
              <span class="problems__badge">{p.badge}</span>
            </figure>
            <div class="problems__body">
              <h3 class="problems__title">{p.title}</h3>
              <p class="problems__text">{p.body}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="problems__controls">
        <button type="button" class="problems__arrow" data-prev aria-label="Previous problem" disabled>
          <Icon name="arrow-left" size={20} />
        </button>

        <div class="problems__dots" data-dots role="tablist" aria-label="Choose a problem card">
          {problems.map((p, i) => (
            <button
              type="button"
              class="problems__dot"
              class:list={{ 'is-active': i === 0 }}
              data-dot={i}
              role="tab"
              aria-selected={i === 0}
              aria-label={`Go to ${p.title}`}
            ></button>
          ))}
        </div>

        <button type="button" class="problems__arrow" data-next aria-label="Next problem">
          <Icon name="arrow-right" size={20} />
        </button>
      </div>
    </div>

    <div class="problems__cta">
      <p>See any of these on your property? Book a camera inspection before it becomes a $20K repair.</p>
      <div class="problems__cta-btns">
        <a class="btn btn--lg" href="#request-form">
          <Icon name="camera" size={20} /> Book Sewer Camera Inspection
        </a>
        <a class="btn btn--ghost btn--lg" href="tel:+13107800362">
          <Icon name="phone" size={18} /> (310) 780-0362
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  function initProblemsCarousel() {
    const carousel = document.querySelector<HTMLElement>('[data-problems-carousel]');
    if (!carousel) return;

    const track = carousel.querySelector<HTMLElement>('[data-track]');
    const prevBtn = carousel.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = carousel.querySelector<HTMLButtonElement>('[data-next]');
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    if (!track) return;

    const cards = Array.from(track.querySelectorAll<HTMLElement>('[data-card]'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const scrollByCard = (dir: 1 | -1) => {
      const card = cards[0];
      if (!card) return;
      const gap = parseFloat(getComputedStyle(track).columnGap || '0');
      const amount = (card.getBoundingClientRect().width + gap) * dir;
      track.scrollBy({ left: amount, behavior: reduceMotion ? 'auto' : 'smooth' });
    };

    prevBtn?.addEventListener('click', () => scrollByCard(-1));
    nextBtn?.addEventListener('click', () => scrollByCard(1));

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        cards[i]?.scrollIntoView({
          behavior: reduceMotion ? 'auto' : 'smooth',
          inline: 'start',
          block: 'nearest',
        });
      });
    });

    const updateArrows = () => {
      const maxScroll = track.scrollWidth - track.clientWidth - 1;
      if (prevBtn) prevBtn.disabled = track.scrollLeft <= 0;
      if (nextBtn) nextBtn.disabled = track.scrollLeft >= maxScroll;
    };

    let rafId: number | null = null;
    track.addEventListener(
      'scroll',
      () => {
        if (rafId) return;
        rafId = requestAnimationFrame(() => {
          updateArrows();
          rafId = null;
        });
      },
      { passive: true }
    );

    if ('IntersectionObserver' in window && dots.length) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting && entry.intersectionRatio >= 0.6) {
              const idx = cards.indexOf(entry.target as HTMLElement);
              dots.forEach((d, i) => {
                d.classList.toggle('is-active', i === idx);
                d.setAttribute('aria-selected', String(i === idx));
              });
            }
          }
        },
        { root: track, threshold: [0.6] }
      );
      cards.forEach((c) => io.observe(c));
    }

    updateArrows();
    window.addEventListener('resize', updateArrows, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProblemsCarousel);
  } else {
    initProblemsCarousel();
  }
</script>

<style>
  .problems {
    position: relative;
    background: var(--ink);
    overflow: hidden;
  }
  .problems__bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 20%, black 40%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 20%, black 40%, transparent 85%);
    pointer-events: none;
    opacity: 0.55;
  }
  .problems__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 50% 30% at 85% 0%, rgba(63, 194, 238, 0.14), transparent 60%),
      radial-gradient(ellipse 40% 30% at 10% 100%, rgba(229, 32, 42, 0.14), transparent 60%);
  }

  .problems__header {
    position: relative;
    max-width: 60ch;
    margin-bottom: 3rem;
  }

  /* ─── Carousel ───────────────────────────────────────────── */
  .problems__carousel {
    position: relative;
  }

  .problems__track {
    position: relative;
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    /* Pin the vertical axis — otherwise `overflow-x: auto` makes overflow-y
       compute to `auto` too, letting the cards be dragged/scrolled up & down. */
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    padding-bottom: 0.25rem;
    margin-bottom: 1.25rem;
    /* Fade the trailing edge so the peeking card reads as "more content" */
    mask-image: linear-gradient(90deg, #000 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, #000 92%, transparent 100%);
  }
  .problems__track::-webkit-scrollbar { display: none; }
  .problems__track { scrollbar-width: none; }

  @media (prefers-reduced-motion: reduce) {
    .problems__track { scroll-behavior: auto; }
  }

  .problems__card {
    position: relative;
    flex: 0 0 82%;
    scroll-snap-align: start;
    background: #15171f;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: border-color var(--t-med), box-shadow var(--t-med), opacity 0.6s var(--ease);
  }
  @media (min-width: 640px) {
    .problems__card { flex-basis: 46%; }
  }
  @media (min-width: 1000px) {
    .problems__card { flex-basis: 31%; }
  }

  .problems__card.reveal:nth-child(1) { transition-delay: 0ms; }
  .problems__card.reveal:nth-child(2) { transition-delay: 50ms; }
  .problems__card.reveal:nth-child(3) { transition-delay: 100ms; }
  .problems__card.reveal:nth-child(n+4) { transition-delay: 150ms; }
  @media (hover: hover) and (pointer: fine) {
    .problems__card:hover {
      border-color: rgba(63, 194, 238, 0.35);
      box-shadow: 0 24px 48px -20px rgba(0,0,0,0.8);
    }
  }
  .problems__card::before {
    content: '';
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--red), var(--cyan));
    opacity: 0.7;
    z-index: 2;
  }

  /* ─── Controls: prev arrow · dots · next arrow ─────────────── */
  .problems__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }

  .problems__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 999px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.14);
    color: #fff;
    transition: transform 140ms var(--ease-out), background var(--t-fast), border-color var(--t-fast), opacity var(--t-fast);
  }
  .problems__arrow:focus-visible { border-radius: 999px; }
  @media (hover: hover) and (pointer: fine) {
    .problems__arrow:hover:not(:disabled) {
      background: rgba(63, 194, 238, 0.14);
      border-color: rgba(63, 194, 238, 0.4);
    }
  }
  .problems__arrow:active:not(:disabled) { transform: scale(0.92); }
  .problems__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .problems__dots {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .problems__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border-radius: 999px;
    background: rgba(255,255,255,0.2);
    transition: transform 140ms var(--ease-out), background var(--t-fast), width var(--t-fast);
  }
  .problems__dot.is-active {
    width: 22px;
    background: var(--cyan);
  }
  @media (hover: hover) and (pointer: fine) {
    .problems__dot:hover:not(.is-active) { background: rgba(255,255,255,0.4); }
  }
  .problems__dot:active { transform: scale(0.9); }

  .problems__figure {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #000;
  }
  .problems__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
    filter: saturate(1.02) contrast(1.05);
  }
  @media (hover: hover) and (pointer: fine) {
    .problems__card:hover .problems__figure img { transform: scale(1.04); }
  }
  .problems__figure::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.75) 100%);
    pointer-events: none;
  }

  .problems__n {
    position: absolute;
    top: 0.75rem;
    left: 0.9rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.25rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 2px 8px rgba(0,0,0,0.6);
    letter-spacing: -0.03em;
    z-index: 2;
  }

  .problems__badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.9rem;
    padding: 0.3rem 0.65rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(63, 194, 238, 0.35);
    border-radius: 999px;
    z-index: 2;
  }

  .problems__body {
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .problems__title {
    color: #fff;
    font-size: 1.3rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.005em;
  }

  .problems__text {
    color: #c9ccd6;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .problems__cta {
    margin-top: 3rem;
    padding: 2rem;
    background: linear-gradient(135deg, rgba(229, 32, 42, 0.14), rgba(63, 194, 238, 0.08));
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-card);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .problems__cta p {
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.05rem, 1vw + 0.8rem, 1.3rem);
    letter-spacing: -0.01em;
    line-height: 1.3;
    max-width: 36ch;
    margin: 0;
  }
  .problems__cta-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
