---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCall from '../components/StickyCall.astro';
import ContactSection from '../components/ContactSection.astro';
import Icon from '../components/Icon.astro';
import { BUSINESS, businessId } from '../data/business';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';

const description =
  'Contact Sewer Pipe Pros Inc. — licensed Los Angeles plumbing, drain & sewer contractor. Call or text (310) 780-0362, 24/7 for emergencies, or request service online.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact Sewer Pipe Pros Inc.',
    description,
    url: `${siteUrl}${base}/contact/`,
    mainEntity: { '@id': businessId(siteUrl, base) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}${base}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${siteUrl}${base}/contact/` },
    ],
  },
];
---

<BaseLayout
  title="Contact Sewer Pipe Pros · (310) 780-0362 · LA Plumbing"
  description={description}
  jsonLd={jsonLd}
>
  <Header />

  <main id="main">
    <section class="page-hero">
      <div class="container page-hero__inner">
        <nav class="page-hero__crumbs" aria-label="Breadcrumb">
          <a href={`${base}/`}>Home</a>
          <span aria-hidden="true">/</span>
          <span>Contact</span>
        </nav>
        <span class="chip chip--dark">
          <Icon name="phone" size={14} /> 24/7 emergency service
        </span>
        <h1 class="page-hero__title">Contact Sewer Pipe Pros</h1>
        <p class="page-hero__lead">
          Call or text <a href="tel:+13107800362" class="text-cyan">{BUSINESS.telDisplay}</a>,
          or send a request below and we'll reach back out — often the same day.
          Serving homes and businesses across Greater Los Angeles.
        </p>
      </div>
    </section>

    <ContactSection
      title="Let's get your plumbing handled."
      lead="Tell us what's going on and we'll get back to you fast. Emergencies? Call (310) 780-0362 — we answer 24/7."
    />
  </main>

  <Footer />
  <StickyCall />
</BaseLayout>

<style>
  .page-hero {
    background:
      radial-gradient(ellipse at 90% 0%, rgba(63,194,238,0.2), transparent 55%),
      radial-gradient(ellipse at 10% 110%, rgba(229,32,42,0.2), transparent 55%),
      var(--ink);
    color: #fff;
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
  }
  .page-hero__inner { max-width: 920px; }
  .page-hero__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.55);
    margin-bottom: 1.25rem;
  }
  .page-hero__crumbs a { color: var(--cyan); }
  .page-hero__title { color: #fff; margin: 1rem 0 1rem; }
  .page-hero__lead { color: #c9ccd6; max-width: 60ch; font-size: 1.15rem; }
</style>
