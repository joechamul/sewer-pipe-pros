---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCall from '../components/StickyCall.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import SewerInspectionCTA from '../components/SewerInspectionCTA.astro';
import CommonProblems from '../components/CommonProblems.astro';
import RecentWork from '../components/RecentWork.astro';
import RealtorSection from '../components/RealtorSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import EmergencyBanner from '../components/EmergencyBanner.astro';
import WhyUs from '../components/WhyUs.astro';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import ContactSection from '../components/ContactSection.astro';
import { areas } from '../data/areas';
import {
  BUSINESS,
  businessId,
  aggregateRating,
  reviewSchema,
  offerCatalog,
  licenseCredential,
  alwaysOpenHours,
  postalAddress,
  geoCoordinates,
} from '../data/business';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  '@id': businessId(siteUrl, base),
  name: BUSINESS.name,
  alternateName: BUSINESS.alternateName,
  description:
    "Sewer Pipe Pros Inc. is a licensed Los Angeles plumbing, drain, and sewer contractor serving Greater LA. Lic. #1126184, C36 & C42.",
  url: `${siteUrl}${base}/`,
  telephone: BUSINESS.telephone,
  priceRange: BUSINESS.priceRange,
  image: `${siteUrl}${base}/logo.png`,
  logo: `${siteUrl}${base}/logo.png`,
  slogan: BUSINESS.slogan,
  areaServed: areas.map((a) => ({ '@type': 'City', name: a.name })),
  address: postalAddress(),
  geo: geoCoordinates(),
  openingHoursSpecification: [alwaysOpenHours()],
  paymentAccepted: 'Cash, Check, Credit Card, Debit Card',
  currenciesAccepted: 'USD',
  sameAs: BUSINESS.sameAs,
  hasCredential: [licenseCredential()],
  hasOfferCatalog: offerCatalog(siteUrl, base),
  aggregateRating: aggregateRating(),
  review: reviewSchema(),
};
---

<BaseLayout
  title="Sewer Pipe Pros Inc. · LA Plumbing, Drain & Sewer Experts"
  description="Licensed Los Angeles plumbing, drain & sewer contractor. Trenchless sewer repair, hydro-jetting, water heaters, repipes and more. Call (310) 780-0362."
  jsonLd={jsonLd}
>
  <Header />

  <main id="main">
    <Hero />
    <TrustBar />
    <Reviews />
    <SewerInspectionCTA />
    <CommonProblems />
    <ServicesGrid />
    <RecentWork />
    <WhyUs />
    <RealtorSection />
    <EmergencyBanner />
    <AboutSection />
    <ContactSection />
    <FAQ />
  </main>

  <Footer />
  <StickyCall />
</BaseLayout>
